# AXOutliner — macOS / Objective-C / AppKit
# No dependency managers (no CocoaPods, Carthage, or SPM remote packages)
# No iOS artifacts (no .ipa, no provisioning profiles)
# Pure Xcode project, not workspace

# ====================
# Xcode
# ====================

# User-specific Xcode settings (window positions, breakpoints, schemes)
# Every developer regenerates these locally — never commit
xcuserdata/

# Xcode workspace settings that change per-machine
*.xcworkspace/xcuserdata/

# Build products — always regenerated
build/
DerivedData/

# Obj-C header maps (intermediate build artifact)
*.hmap

# Precompiled headers (intermediate build artifact)
*.pch.gch

# Index data store (Xcode rebuilds this automatically)
# Can grow to hundreds of MB in large projects
IndexStoreData/

# ====================
# Build Artifacts
# ====================

# Debug symbols archive (regenerate from .dSYM if needed)
*.dSYM.zip
*.dSYM/

# macOS app bundle (build product, not source)
*.app

# Object files
*.o
*.obj

# ====================
# OS & Editor Junk
# ====================

# macOS Finder metadata
.DS_Store

# macOS resource forks and Finder info
._*

# Spotlight indexing
.Spotlight-V100

# Trash folder on external volumes
.Trashes

# Thumbnail cache
Thumbs.db

# ====================
# Instruments & Profiling
# ====================

# Instruments trace documents (can be enormous)
# Keep screenshots of clean runs in docs/, not the raw traces
*.trace
*.trace/

# ====================
# Project-Specific
# ====================

# Anything in a scratch/ directory (local experimentation)
scratch/

# Temporary test output
test_output/
